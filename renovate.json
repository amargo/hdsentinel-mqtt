{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "config:best-practices",
    "group:monorepos",
    "group:recommended",
    ":pinDigestsDisabled",
    "workarounds:all",
    "abandonments:recommended"
  ],
  "timezone": "Europe/Budapest",
  "schedule": [
    "after 1am and before 5am on friday"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 2,
  "enabledManagers": [
    "dockerfile",
    "pip_requirements",
    "github-actions"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "📦 Dependency Dashboard",
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": [
      "security"
    ]
  },
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": false
    },
    {
      "description": "One PR for every non-major update across all managers",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "📦 Non-major updates",
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "GitHub Actions (any update) and majors: one PR, manual review, never automerged",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "🔍 Review required: majors and GitHub Actions",
      "automerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "🔍 Review required: majors and GitHub Actions",
      "automerge": false
    }
  ]
}
